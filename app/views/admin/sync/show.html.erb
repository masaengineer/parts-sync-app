<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <!-- ヘッダー -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">eBay同期管理</h1>
      <p class="text-gray-600">eBay注文と取引手数料の同期を手動で実行できます</p>
    </div>

    <!-- ステータスカード -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold text-gray-800 mb-2">同期ステータス</h2>
          <% if @is_running %>
            <div class="flex items-center">
              <div class="w-3 h-3 bg-yellow-500 rounded-full animate-pulse mr-2"></div>
              <span class="text-yellow-600 font-medium">実行中</span>
            </div>
          <% else %>
            <div class="flex items-center">
              <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
              <span class="text-green-600 font-medium">待機中</span>
            </div>
          <% end %>
        </div>
        
        <div class="text-right">
          <p class="text-sm text-gray-500 mb-1">定期実行</p>
          <p class="text-lg font-semibold text-gray-800">1日3回</p>
          <p class="text-sm text-gray-600">6:00, 14:00, 20:00</p>
        </div>
      </div>
    </div>

    <!-- 手動実行ボタン -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">手動実行</h2>
      <p class="text-gray-600 mb-4">同期を手動で実行します。通常は1-5分程度で完了します。</p>
      
      <%= form_with url: admin_sync_path, method: :post, local: true, class: "inline-block" do |form| %>
        <% if @is_running %>
          <button type="button" disabled class="bg-gray-300 text-gray-500 px-6 py-2 rounded-lg cursor-not-allowed">
            実行中...
          </button>
        <% else %>
          <%= form.submit "同期を実行", 
                class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors duration-200 cursor-pointer",
                confirm: "eBay同期を実行しますか？",
                data: { disable_with: "実行中..." } %>
        <% end %>
      <% end %>
    </div>

    <!-- 実行ログ -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-800">最近の実行ログ</h2>
        <% if @is_running %>
          <button onclick="location.reload()" class="text-blue-600 hover:text-blue-800 text-sm">
            更新
          </button>
        <% end %>
      </div>
      
      <% if @recent_logs.any? %>
        <div class="bg-gray-50 rounded-lg p-4 max-h-96 overflow-y-auto">
          <pre class="text-sm text-gray-700 whitespace-pre-wrap font-mono"><%= @recent_logs.join %></pre>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <p>実行ログがありません</p>
          <p class="text-sm mt-1">同期を実行するとここにログが表示されます</p>
        </div>
      <% end %>
    </div>

    <!-- 注意事項 -->
    <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">ご注意</h3>
          <div class="mt-2 text-sm text-yellow-700">
            <ul class="list-disc pl-5 space-y-1">
              <li>同期中は他の同期処理は実行されません</li>
              <li>大量のデータがある場合、完了まで時間がかかることがあります</li>
              <li>エラーが発生した場合は自動的に3回まで再試行されます</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>